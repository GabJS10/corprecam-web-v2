---
// Importamos el Layout base de Astro y nuestro Header
import Layout from '../layouts/Layout.astro';
import SectionAbout from '../components/SectionAbout.astro';
import MidSection from '../sections/MidSection.astro';
import Allies from '../components/Allies.astro'
// ¡Cambia esto por la ruta a tu propia imagen en la carpeta `public/`!
// Ejemplo: const bgImageUrl = "/imagenes/mi-fondo.jpg";
import Hero from '../components/Hero.astro';


const bgImageUrl = "https://corprecam.com/wp-content/uploads/2023/10/Diseno-sin-titulo-2023-10-03T100736.251.png";
---

<Layout title="Corprecam E.S.P" >

  <Hero bgImageUrl={bgImageUrl} titleHero='Dignificamos la labor del reciclador de oficio' descriptionHero='Promovemos la educación y conciencia ciudadana sobre la importancia de reciclar y manejar adecuadamente los residuos. ' textButton="Conoce mas" hrefButton='#section-about' />

  <SectionAbout />
  
  <MidSection/>

  <Allies/>


  <section 
  class="relative flex flex-col items-center justify-center min-h-[50vh] px-6 text-center overflow-hidden bg-kraft border-t-2 border-steel"
>
  <!-- Decorative background elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-10 left-10 w-32 h-32 bg-moss/20 rounded-full border border-moss animate-float-slow"></div>
    <div class="absolute bottom-10 right-10 w-48 h-48 bg-safety/10 rounded-full border border-safety animate-float-reverse"></div>
  </div>

  <!-- Contenido -->
  <div class="relative z-10 max-w-2xl bg-paper p-8 rounded-lg border-2 border-steel shadow-tactile">
    <p class="text-steel text-lg md:text-xl mb-8 font-medium" data-aos="fade-up">
      Conoce más sobre nuestra gestión social en
      <a href="/nuestra-gestion" class="text-forest font-bold hover:text-safety transition-colors duration-300 underline decoration-2 decoration-forest hover:decoration-safety underline-offset-4">
        Nuestra gestión
      </a>
    </p>

    <a 
      href="/contacto"
      class="inline-block px-8 py-3 bg-forest text-white font-bold uppercase tracking-wider rounded-sm border-2 border-steel shadow-tactile hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-tactile-sm transition-all duration-200"
      data-aos="zoom-in"
    >
      ¡Contáctanos!
    </a>
  </div>
  </section>



</Layout>
