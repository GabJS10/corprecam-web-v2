---
import Layout from "../../../layouts/Layout.astro";
import SidebarMicrorutas from "../../../components/SidebarMicrorutas.astro";
import Hero from "../../../components/Hero.astro";
import type { Macroruta } from "../../../types/strapi";

export async function getStaticPaths() {
  const STRAPI_URL = import.meta.env.STRAPI_URL || "http://localhost:1337";
  const STRAPI_TOKEN = import.meta.env.STRAPI_API_TOKEN;

  try {
    const response = await fetch(
      `${STRAPI_URL}/api/macrorutas?fields[0]=slug&populate[microrutas][fields][0]=slug`,
      {
        headers: { Authorization: `Bearer ${STRAPI_TOKEN}` },
      },
    );
    const data = await response.json();
    const items = data.data || [];

    return items.map((ruta: any) => ({
      params: { macro_slug: ruta.slug },
    }));
  } catch (error) {
    console.error("Error building static paths for macrorutas:", error);
    return [];
  }
}

const { macro_slug } = Astro.params;

const STRAPI_URL = import.meta.env.STRAPI_URL || "http://localhost:1337";
const STRAPI_TOKEN = import.meta.env.STRAPI_API_TOKEN;

let macrorutaContext: Macroruta | null = null;
let error = null;

try {
  const response = await fetch(
    `${STRAPI_URL}/api/macrorutas?filters[slug][$eq]=${macro_slug}&populate[microrutas][fields][0]=name&populate[microrutas][fields][1]=slug&fields[0]=name&fields[1]=slug&fields[2]=description`,
    {
      headers: {
        Authorization: `Bearer ${STRAPI_TOKEN}`,
      },
    },
  );
  const data = await response.json();

  if (data.data && data.data.length > 0) {
    macrorutaContext = data.data[0];
  } else {
    error = "Macroruta no encontrada";
  }
} catch (e) {
  console.error("Error fetching macroruta context:", e);
  error = "Error cargando la información.";
}

const heroImage =
  "https://corprecam.com/wp-content/uploads/2023/10/Diseno-sin-titulo-2023-10-03T100736.251.png";
---

<Layout title={macrorutaContext ? macrorutaContext.name : "Detalle Macroruta"}>
  <Hero
    bgImageUrl={heroImage}
    titleHero={macrorutaContext ? macrorutaContext.name : "Macroruta"}
    descriptionHero={macrorutaContext?.description ||
      "Explora las zonas de recolección y sus recicladores asociados."}
    textButton="Ver Microrutas"
    hrefButton="#contenido-macroruta"
  />

  <div id="contenido-macroruta" class="bg-kraft min-h-screen">
    <div class="container mx-auto px-4 md:px-6 py-12">
      <a
        href="/recolecciones"
        class="inline-flex items-center text-forest font-bold mb-8 hover:underline uppercase tracking-wider text-sm"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 mr-2"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
            clip-rule="evenodd"></path>
        </svg>
        Volver a todas las rutas
      </a>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
        <div class="md:col-span-4 lg:col-span-3">
          {
            macrorutaContext && (
              <SidebarMicrorutas
                macrorutaSlug={macrorutaContext.slug}
                microrutas={macrorutaContext.microrutas || []}
                currentSlug={macrorutaContext.slug}
              />
            )
          }
        </div>

        <main class="md:col-span-8 lg:col-span-9">
          {/* Renderizado Condicional: Error vs Mensaje de Selección */}
          {
            error ? (
              <div class="text-center py-12 bg-white rounded-xl shadow-sm border border-stone-200">
                <h2 class="text-2xl font-bold text-red-600 mb-2">Error</h2>
                <p class="text-stone-600">{error}</p>
              </div>
            ) : (
              <div class="text-center py-20 bg-white rounded-xl shadow-sm border border-stone-200 animate-fade-in-up">
                <div class="w-24 h-24 bg-moss/10 rounded-full flex items-center justify-center mx-auto mb-6 border-2 border-moss text-forest shadow-sm">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-10 w-10"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0121 18.382V7.618a1 1 0 01-.553-.894L15 4m0 13V4m0 0L9 7"
                    />
                  </svg>
                </div>

                <h2 class="text-3xl font-black uppercase text-steel mb-4 tracking-tight">
                  Selecciona una Ruta
                </h2>

                <p class="text-stone-600 font-medium text-lg leading-relaxed relative max-w-md mx-auto">
                  Explora el menú lateral para ver el mapa detallado.
                  <svg
                    class="hidden md:block absolute -left-20 top-2 w-12 h-12 text-forest/30 rotate-180 transform -scale-y-100"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d="M10 19l-7-7m0 0l7-7m-7 7h18"
                    />
                  </svg>
                </p>
              </div>
            )
          }
        </main>
      </div>
    </div>
  </div>
</Layout>
